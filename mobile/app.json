{
  "expo": {
    "name": "K-Stock Manager",
    "slug": "k-stock-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kstockmanager.app"
    },
    "android": {
      "package": "com.kstockmanager.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030712"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "K-Stock a besoin de la caméra pour scanner les codes-barres."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "afb8f812-56d9-4a42-84a8-68d6742b683e"
      }
    },
    "owner": "rush_limitless"
  }
}
